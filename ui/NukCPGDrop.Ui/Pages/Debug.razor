@page "/debug"
@implements IDisposable
@using NukCPGDrop.Ui.Models

<PageTitle>Debug - NukCPGDrop</PageTitle>

<div class="debug-shell">
    <h1>Debug</h1>

    <section class="debug-section">
        <h2>System Status</h2>
        <div class="status-grid">
            <div class="stat-row">
                <span>Drop Count (total)</span>
                <span class="stat-value">@(_status?.DropCount ?? 0)</span>
            </div>
            <div class="stat-row">
                <span>PCA9685</span>
                <span class="stat-value @(_pcaOk ? "ok" : "err")">
                    @(_pcaOk ? "Detected" : (_status == null ? "Connecting..." : "Not found"))
                </span>
            </div>
            <div class="stat-row">
                <span>ESP Connection</span>
                <span class="stat-value @(_connected ? "ok" : "err")">
                    @(_connected ? "Connected" : "Disconnected")
                </span>
            </div>
            <div class="stat-row">
                <span>RGB LED</span>
                <span class="stat-value" style="color: rgb(@(ledR), @(ledG), @(ledB));">
                    @if (_status?.Led != null) { <text>R=@ledR G=@ledG B=@ledB</text> }
                    else { <text>--</text> }
                </span>
            </div>
            <div class="stat-row">
                <span>Held Cans</span>
                <span class="stat-value">@heldStr</span>
            </div>
        </div>
    </section>

    <section class="debug-section">
        <h2>Servo Calibration</h2>
        <p class="section-note">Drag the slider to adjust servo travel range (500-2500 µs)</p>
        @for (int i = 0; i < 6; i++)
        {
            <div class="servo-cal-row">
                <span class="servo-label">Servo @(i + 1)</span>
                <div class="range-container">
                    <RangeSlider Min="500" Max="2500" RangeMode="true"
                                 Value="@((double)_servoMin[i])"
                                 RangeHigh="@((double)_servoMax[i])"
                                 RangeChanged="(r) => OnServoRangeChanged(i, r)" />
                    <div class="range-readout">
                        <span class="readout-min">@_servoMin[i] µs</span>
                        <span class="readout-max">@_servoMax[i] µs</span>
                    </div>
                </div>
                <button class="test-btn" @onclick="() => TestServo(i)">Test</button>
            </div>
        }
    </section>

    <a href="/" class="back-link">Back to Dashboard</a>
</div>

@code {
    [Inject] private ApiService Api { get; set; } = default!;

    private SystemStatus? _status;
    private bool _connected;
    private bool _pcaOk;
    private int ledR, ledG, ledB;
    private string heldStr = "";
    private int[] _servoMin = { 500, 500, 500, 500, 500, 500 };
    private int[] _servoMax = { 2500, 2500, 2500, 2500, 2500, 2500 };
    private Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _pollTimer = new Timer(async _ => await InvokeAsync(Refresh), null, 1000, 2000);
    }

    private async Task Refresh()
    {
        _status = await Api.GetStatusAsync();
        _connected = _status != null;
        if (_status != null)
        {
            _pcaOk = _status.Pca9685Present;
            if (_status.Led != null) { ledR = _status.Led.R; ledG = _status.Led.G; ledB = _status.Led.B; }
            heldStr = string.Join(" ", _status.Held.Select((h, i) => h ? $"{i + 1}" : "_"));
        }
        StateHasChanged();
    }

    private void OnServoRangeChanged(int idx, (double Low, double High) range)
    {
        _servoMin[idx] = (int)range.Low;
        _servoMax[idx] = (int)range.High;
    }

    private async Task TestServo(int idx)
    {
        await Api.DropOneAsync(idx + 1);
        await Refresh();
    }

    public void Dispose() => _pollTimer?.Dispose();
}

<style>
    .debug-shell {
        max-width: 600px;
        margin: 0 auto;
        padding: 1rem;
    }
    h1 {
        font-size: 1.4rem;
        margin-bottom: 1rem;
        color: var(--accent-color, #e63946);
    }
    .debug-section {
        margin-bottom: 1.5rem;
    }
    h2 {
        font-size: 1rem;
        margin-bottom: 0.5rem;
        color: var(--text-color, #f0f0f0);
    }
    .section-note {
        font-size: 0.8rem;
        color: var(--text-muted, #888);
        margin-bottom: 0.75rem;
    }
    .status-grid {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }
    .stat-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        padding: 0.3rem 0;
        border-bottom: 1px solid var(--border-color, #333);
    }
    .stat-value { font-weight: 600; }
    .stat-value.ok { color: #28a745; }
    .stat-value.err { color: #dc3545; }
    .servo-cal-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        padding: 0.5rem;
        background: #1a1a1a;
        border-radius: 6px;
    }
    .servo-label {
        min-width: 55px;
        font-size: 0.8rem;
        font-weight: 600;
    }
    .range-container {
        flex: 1;
    }
    .range-readout {
        display: flex;
        justify-content: space-between;
        font-size: 0.7rem;
        color: var(--text-muted, #888);
        margin-top: 2px;
    }
    .readout-min { color: var(--accent-color, #e63946); }
    .readout-max { color: #c1121f; }
    .test-btn {
        padding: 0.3rem 0.6rem;
        border: 1px solid var(--accent-color, #e63946);
        border-radius: 4px;
        background: transparent;
        color: var(--accent-color, #e63946);
        cursor: pointer;
        font-size: 0.75rem;
        min-width: 40px;
    }
    .test-btn:hover { background: var(--accent-color, #e63946); color: #fff; }
    .back-link {
        display: block;
        text-align: center;
        margin-top: 1rem;
        color: var(--text-muted, #888);
        font-size: 0.8rem;
    }
</style>

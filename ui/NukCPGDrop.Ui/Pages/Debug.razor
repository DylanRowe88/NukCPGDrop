@page "/debug"
@implements IDisposable
@using NukCPGDrop.Ui.Models
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Debug - NukCPGDrop</PageTitle>

<div class="debug-shell">
    <h1>Debug</h1>

    <section class="debug-section">
        <h2>System</h2>
        <div class="status-grid">
            <div class="stat-row"><span>Version</span><span class="stat-value">@(_status?.Wifi?.Version ?? "--")</span></div>
            <div class="stat-row"><span>Drop Count</span><span class="stat-value">@(_status?.DropCount ?? 0)</span></div>
            <div class="stat-row"><span>PCA9685</span><span class="stat-value @(_pcaOk ? "ok" : "err")">@(_pcaOk ? "Detected" : (_status == null ? "Connecting..." : "Not found"))</span></div>
            <div class="stat-row"><span>ESP</span><span class="stat-value @(_connected ? "ok" : "err")">@(_connected ? "Connected" : "Disconnected")</span></div>
            <div class="stat-row"><span>WiFi Clients</span><span class="stat-value">@(_status?.Wifi?.Clients ?? 0)</span></div>
            @if (_status?.Wifi?.ClientsList != null)
            {
                foreach (var cl in _status.Wifi.ClientsList)
                {
                    <div class="stat-row client-row"><span class="client-mac">@cl.Mac</span><span class="stat-value">@cl.Rssi dBm</span></div>
                }
            }
            <div class="stat-row"><span>Your IP</span><span class="stat-value">@clientIp</span></div>
            <div class="stat-row"><span>Sound</span><span class="stat-value @(_status?.SoundEnabled == true ? "ok" : "err")">@(_status?.SoundEnabled == true ? "ON" : "OFF")</span></div>
        </div>
    </section>

    <section class="debug-section">
        <h2>WiFi</h2>
        <div class="status-grid">
            <div class="stat-row"><span>RSSI</span><span class="stat-value">@(_status?.Wifi?.Rssi ?? 0) dBm</span></div>
            <div class="stat-row"><span>Signal</span><span class="stat-value"><WifiIcon Signal="@WifiSignalLevel" Size="20px" Color="var(--accent-color, #e63946)" /></span></div>
            <div class="stat-row"><span>Clients</span><span class="stat-value">@(_status?.Wifi?.Clients ?? 0)</span></div>
        </div>
    </section>

    <section class="debug-section">
        <h2>Servo Positions</h2>
        <div class="servo-pos-control">
            <div class="range-row">
                <span class="range-label">Held:</span>
                <span class="range-value">@_svHeld&deg;</span>
                <input type="range" class="range-input" min="0" max="180" value="@_svHeld" @onchange="OnSvHeldChanged" />
            </div>
            <div class="range-row">
                <span class="range-label">Dropped:</span>
                <span class="range-value">@_svDropped&deg;</span>
                <input type="range" class="range-input" min="0" max="180" value="@_svDropped" @onchange="OnSvDroppedChanged" />
            </div>
        </div>
    </section>

    <section class="debug-section">
        <h2>Sound</h2>
        <div class="sound-controls">
            <label class="toggle-row">
                <span>Sound Effects</span>
                <label class="switch">
                    <input type="checkbox" checked="@_soundEnabled" @onchange="OnSoundToggled" />
                    <span class="slider"></span>
                </label>
            </label>
        </div>
    </section>

    <section class="debug-section">
        <h2>Microphone &mdash; Spectrum</h2>
        <p class="section-note">Rolling FFT from onboard mic. 8 frequency bins, 0-8kHz.</p>
        <div class="spectrum-container">
            <canvas id="fftCanvas" width="520" height="160"></canvas>
        </div>
    </section>

    <footer class="debug-footer">
        <a href="/" class="back-link">Back to Dashboard</a>
        <a href="https://github.com/DylanRowe88/NukCPGDrop" target="_blank" rel="noopener" class="gh-link">GitHub</a>
    </footer>
</div>

@code {
    [Inject] private ApiService Api { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private SystemStatus? _status;
    private bool _connected, _pcaOk;
    private string clientIp = "--";
    private int _svHeld;
    private int _svDropped = 180;
    private bool _soundEnabled = true;
    private Timer? _pollTimer;
    private Timer? _fftTimer;
    private HttpClient _http = new HttpClient();

    private int WifiSignalLevel
    {
        get
        {
            int r = _status?.Wifi?.Rssi ?? -100;
            if (r > -50) return 4; if (r > -65) return 3; if (r > -75) return 2; if (r > -85) return 1; return 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _pollTimer = new Timer(async _ => await InvokeAsync(Refresh), null, 1000, 3000);
        _fftTimer = new Timer(async _ => await InvokeAsync(PollFft), null, 2000, 800);
        try { clientIp = await JSRuntime.InvokeAsync<string>("eval", new[] { "window.location.hostname || ''" }); } catch { }
    }

    private async Task Refresh()
    {
        _status = await Api.GetStatusAsync();
        _connected = _status != null;
        if (_status != null)
        {
            _pcaOk = _status.Pca9685Present;
            _svHeld = _status.SvStartPos;
            _svDropped = _status.SvStopPos;
            _soundEnabled = _status.SoundEnabled;
        }
        StateHasChanged();
    }

    private async Task PollFft()
    {
        try
        {
            var json = await _http.GetStringAsync(Nav.BaseUri + "api/audio/fft");
            var fft = System.Text.Json.JsonSerializer.Deserialize<FftData>(json);
            if (fft?.Spectrum != null) await DrawSpectrum(fft.Spectrum);
        }
        catch { }
    }

    private async Task DrawSpectrum(int[] bins)
    {
        try
        {
            var c = await JSRuntime.InvokeAsync<IJSObjectReference>("eval", "document.getElementById('fftCanvas')");
            if (c != null)
            {
                var ctx = await c.InvokeAsync<IJSObjectReference>("getContext", "2d");
                int w = 520, h = 160;
                await ctx.InvokeVoidAsync("clearRect", 0, 0, w, h);
                int max = Math.Max(1, bins.Max());
                int barW = (w - 16) / bins.Length;
                for (int i = 0; i < bins.Length; i++)
                {
                    int barH = (int)((double)bins[i] / max * (h - 16));
                    int x = 8 + i * barW;
                    string? color = i < 3 ? "#28a745" : i < 6 ? "#e6a700" : "#e63946";
                    await ctx.InvokeVoidAsync("fillStyle", color);
                    await ctx.InvokeVoidAsync("fillRect", x + 2, h - 8 - barH, barW - 4, barH);
                }
                await ctx.InvokeVoidAsync("fillStyle", "#888");
                await ctx.InvokeVoidAsync("font", "9px sans-serif");
                await ctx.InvokeVoidAsync("textAlign", "center");
                for (int i = 0; i < bins.Length; i++)
                    await ctx.InvokeVoidAsync("fillText", (i * 1000) + "Hz", 8 + i * barW + barW / 2, h - 1);
            }
        }
        catch { }
    }

    private async Task OnSvHeldChanged(ChangeEventArgs e)
    {
        _svHeld = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        await Api.PostAsync("/api/servo_config", new { sv_start_pos = _svHeld, sv_stop_pos = _svDropped });
    }
    private async Task OnSvDroppedChanged(ChangeEventArgs e)
    {
        _svDropped = int.TryParse(e.Value?.ToString(), out var v) ? v : 180;
        await Api.PostAsync("/api/servo_config", new { sv_start_pos = _svHeld, sv_stop_pos = _svDropped });
    }
    private async Task OnSoundToggled(ChangeEventArgs e)
    {
        _soundEnabled = (bool)(e.Value ?? false);
        await Api.UpdateConfigAsync(new DropConfiguration { SoundEnabled = _soundEnabled });
    }

    public void Dispose() { _pollTimer?.Dispose(); _fftTimer?.Dispose(); }

    private class FftData { public int[]? Spectrum { get; set; } }
}

<style>
    .debug-shell { max-width: 600px; margin: 0 auto; padding: 1rem; }
    h1 { font-size: 1.4rem; margin-bottom: 1rem; color: var(--accent-color, #e63946); }
    .debug-section { margin-bottom: 1.5rem; }
    h2 { font-size: 1rem; margin-bottom: 0.5rem; color: var(--text-color, #f0f0f0); }
    .section-note { font-size: 0.8rem; color: var(--text-muted, #888); margin-bottom: 0.75rem; }
    .status-grid { display: flex; flex-direction: column; gap: 0.3rem; }
    .stat-row { display: flex; justify-content: space-between; font-size: 0.85rem; padding: 0.3rem 0; border-bottom: 1px solid var(--border-color, #333); }
    .stat-value { font-weight: 600; }
    .stat-value.ok { color: #28a745; } .stat-value.err { color: #dc3545; }
    .client-row { font-size: 0.75rem; padding-left: 1rem; }
    .client-mac { font-family: monospace; font-size: 0.7rem; }
    .servo-pos-control { background: #1a1a1a; border-radius: 6px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.75rem; }
    .range-row { display: flex; align-items: center; gap: 0.5rem; }
    .range-label { font-size: 0.85rem; min-width: 60px; }
    .range-value { font-size: 0.85rem; font-weight: 600; min-width: 45px; text-align: right; color: var(--accent-color, #e63946); }
    .range-input { flex: 1; accent-color: var(--accent-color, #e63946); }
    .sound-controls { background: #1a1a1a; border-radius: 6px; padding: 0.75rem; }
    .toggle-row { display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
    .switch { position: relative; width: 44px; height: 24px; display: inline-block; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; inset: 0; background: #444; border-radius: 24px; transition: 0.3s; }
    .slider::before { content: ''; position: absolute; left: 3px; bottom: 3px; width: 18px; height: 18px; background: #fff; border-radius: 50%; transition: 0.3s; }
    .switch input:checked + .slider { background: #28a745; }
    .switch input:checked + .slider::before { transform: translateX(20px); }
    .spectrum-container { background: #111; border-radius: 6px; padding: 0; overflow: hidden; }
    #fftCanvas { display: block; width: 100%; height: auto; max-width: 520px; }
    .debug-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; }
    .back-link { color: var(--text-muted, #888); font-size: 0.8rem; text-decoration: none; }
    .gh-link { color: var(--text-muted, #888); font-size: 0.8rem; text-decoration: none; }
    .gh-link:hover { color: var(--accent-color, #e63946); }
</style>

@page "/debug"
@implements IDisposable
@using NukCPGDrop.Ui.Models
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Debug - NukCPGDrop</PageTitle>

<div class="debug-shell">
    <h1>Debug</h1>

    <section class="debug-section">
        <h2>System</h2>
        <div class="status-grid">
            <div class="stat-row">
                <span>Version</span>
                <span class="stat-value">@(_status?.Wifi?.Version ?? "--")</span>
            </div>
            <div class="stat-row">
                <span>Drop Count</span>
                <span class="stat-value">@(_status?.DropCount ?? 0)</span>
            </div>
            <div class="stat-row">
                <span>PCA9685</span>
                <span class="stat-value @(_pcaOk ? "ok" : "err")">@(_pcaOk ? "Detected" : (_status == null ? "Connecting..." : "Not found"))</span>
            </div>
            <div class="stat-row">
                <span>ESP</span>
                <span class="stat-value @(_connected ? "ok" : "err")">@(_connected ? "Connected" : "Disconnected")</span>
            </div>
            <div class="stat-row">
                <span>WiFi Clients</span>
                <span class="stat-value">@(_status?.Wifi?.Clients ?? 0)</span>
            </div>
            <div class="stat-row">
                <span>Your IP</span>
                <span class="stat-value">@clientIp</span>
            </div>
            <div class="stat-row">
                <span>RGB LED</span>
                <span class="stat-value" style="color: @ledColor;">@(ledColor != "transparent" ? $"R={lr} G={lg} B={lb}" : "--")</span>
            </div>
            <div class="stat-row">
                <span>Sound</span>
                <span class="stat-value @(_status?.SoundEnabled == true ? "ok" : "err")">@(_status?.SoundEnabled == true ? "ON" : "OFF")</span>
            </div>
        </div>
    </section>

    <section class="debug-section">
        <h2>WiFi</h2>
        <div class="status-grid">
            <div class="stat-row">
                <span>RSSI</span>
                <span class="stat-value">@(_status?.Wifi?.Rssi ?? 0) dBm</span>
            </div>
            <div class="stat-row">
                <span>Signal</span>
                <span class="stat-value"><WifiIcon Signal="@WifiSignalLevel" Size="20px" Color="var(--accent-color, #e63946)" /></span>
            </div>
            <div class="stat-row">
                <span>Clients</span>
                <span class="stat-value">@(_status?.Wifi?.Clients ?? 0)</span>
            </div>
        </div>
    </section>

    <section class="debug-section">
        <h2>Servo Positions</h2>
        <p class="section-note">Drag ends to set range. Toggle arrow to set which end is HELD.</p>
        @for (int sv = 0; sv < 6; sv++)
        {
            var idx = sv;
            <div class="servo-row">
                <div class="servo-head">
                    <span class="servo-label">@(idx + 1)</span>
                    <span class="servo-state @(_status?.Held != null && _status.Held[idx] ? "held" : "dropped")">
                        @(_status?.Held != null && _status.Held[idx] ? "HELD" : "DROP")
                    </span>
                </div>
                <div class="servo-slider">
                    <RangeSlider Min="0" Max="180" Step="1" RangeMode="true"
                                 LowValue="@((double)_svMin[idx])"
                                 HighValue="@((double)_svMax[idx])"
                                 LowValueChanged="(v) => OnSvLow(idx, v)"
                                 HighValueChanged="(v) => OnSvHigh(idx, v)" />
                </div>
                <div class="servo-dir-group">
                    <button class="servo-dir @(_svDir[idx] ? "active" : "")" @onclick="() => ToggleSvDir(idx)" title="Toggle held direction">
                        <span class="dir-icon">@(_svDir[idx] ? "\u25B2" : "\u25BC")</span>
                        <span class="dir-label">@(_svDir[idx] ? "Hi" : "Lo")</span>
                    </button>
                </div>
                <button class="servo-toggle" @onclick="() => ToggleServo(idx)" title="Toggle servo">
                    <span class="toggle-icon">@(_status?.Held != null && _status.Held[idx] ? "\u25BC" : "\u25B2")</span>
                </button>
            </div>
        }
    </section>

    <section class="debug-section">
        <h2>Sound</h2>
        <div class="sound-controls">
            <label class="toggle-row">
                <span>Sound Effects</span>
                <label class="switch">
                    <input type="checkbox" checked="@_soundEnabled" @onchange="OnSoundToggled" />
                    <span class="slider"></span>
                </label>
            </label>
        </div>
    </section>

    <section class="debug-section">
        <h2>Microphone &mdash; Spectrum</h2>
        <p class="section-note">Rolling FFT from onboard mic. 8 frequency bins, 0-8kHz.</p>
        <div class="spectrum-container">
            <canvas id="fftCanvas" width="520" height="160"></canvas>
        </div>
    </section>

    <footer class="debug-footer">
        <a href="/" class="back-link">Back to Dashboard</a>
        <a href="https://github.com/DylanRowe88/NukCPGDrop" target="_blank" rel="noopener" class="gh-link">GitHub</a>
    </footer>
</div>

@code {
    [Inject] private ApiService Api { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private SystemStatus? _status;
    private bool _connected, _pcaOk;
    private int lr, lg, lb;
    private string ledColor = "transparent";
    private string clientIp = "--";
    private int[] _svMin = { 25, 25, 25, 25, 25, 25 };
    private int[] _svMax = { 120, 120, 120, 120, 120, 120 };
    private bool[] _svDir = { false, false, false, false, false, false };
    private bool _soundEnabled = true;
    private Timer? _pollTimer;
    private Timer? _fftTimer;
    private HttpClient _http = new HttpClient();

    private int WifiSignalLevel
    {
        get
        {
            int r = _status?.Wifi?.Rssi ?? -100;
            if (r > -50) return 4;
            if (r > -65) return 3;
            if (r > -75) return 2;
            if (r > -85) return 1;
            return 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _pollTimer = new Timer(async _ => await InvokeAsync(Refresh), null, 1000, 3000);
        _fftTimer = new Timer(async _ => await InvokeAsync(PollFft), null, 2000, 800);
        try { clientIp = await JSRuntime.InvokeAsync<string>("eval", new[] { "window.location.hostname || ''" }); } catch { }
    }

    private async Task Refresh()
    {
        _status = await Api.GetStatusAsync();
        _connected = _status != null;
        if (_status != null)
        {
            _pcaOk = _status.Pca9685Present;
            if (_status.Led != null) { lr = _status.Led.R; lg = _status.Led.G; lb = _status.Led.B; ledColor = $"rgb({lr},{lg},{lb})"; }
            if (_status.Servos != null)
            {
                for (int i = 0; i < 6 && i < _status.Servos.Dir.Length; i++) _svDir[i] = _status.Servos.Dir[i];
                for (int i = 0; i < 6 && i < _status.Servos.Min.Length; i++) _svMin[i] = _status.Servos.Min[i];
                for (int i = 0; i < 6 && i < _status.Servos.Max.Length; i++) _svMax[i] = _status.Servos.Max[i];
            }
            _soundEnabled = _status.SoundEnabled;
        }
        StateHasChanged();
    }

    private async Task PollFft()
    {
        try
        {
            var json = await _http.GetStringAsync(Nav.BaseUri + "api/audio/fft");
            var fft = System.Text.Json.JsonSerializer.Deserialize<FftData>(json);
            if (fft?.Spectrum != null)
                await DrawSpectrum(fft.Spectrum);
        }
        catch { }
    }

    private async Task DrawSpectrum(int[] bins)
    {
        try
        {
            var js = $"drawSpectrum({string.Join(",", bins)})";
            await JSRuntime.InvokeVoidAsync("eval", js);
        }
        catch { }
    }

    private void OnSvLow(int idx, double v)
    {
        if (idx < 0 || idx >= 6) return;
        _svMin[idx] = (int)Math.Clamp(v, 0, _svMax[idx] - 1);
        _ = SaveServoConfig();
    }

    private void OnSvHigh(int idx, double v)
    {
        if (idx < 0 || idx >= 6) return;
        _svMax[idx] = (int)Math.Clamp(v, _svMin[idx] + 1, 180);
        _ = SaveServoConfig();
    }

    private void ToggleSvDir(int idx)
    {
        if (idx < 0 || idx >= 6) return;
        _svDir[idx] = !_svDir[idx];
        _ = SaveServoConfig();
    }

    private async Task SaveServoConfig()
    {
        try { await Api.PostAsync("/api/servo_config", new { servos = new { dir = _svDir, min = _svMin, max = _svMax } }); }
        catch { }
    }

    private async Task ToggleServo(int idx)
    {
        if (_status == null || idx >= _status.Held.Length) return;
        if (_status.Held[idx]) await Api.DropOneAsync(idx + 1); else await Api.HoldOneAsync(idx + 1);
        await Refresh();
    }

    private async Task OnSoundToggled(ChangeEventArgs e)
    {
        _soundEnabled = (bool)(e.Value ?? false);
        await Api.UpdateConfigAsync(new DropConfiguration { SoundEnabled = _soundEnabled });
    }

    public void Dispose() { _pollTimer?.Dispose(); _fftTimer?.Dispose(); }

    private class FftData { public int[]? Spectrum { get; set; } }
}

<script>
    window.drawSpectrum = function(b0,b1,b2,b3,b4,b5,b6,b7) {
        var c = document.getElementById('fftCanvas');
        if (!c) return;
        var ctx = c.getContext('2d');
        ctx.clearRect(0, 0, c.width, c.height);
        var bins = [b0,b1,b2,b3,b4,b5,b6,b7];
        var w = (c.width - 16) / 8;
        var max = Math.max(1, Math.max.apply(null, bins));
        for (var i = 0; i < 8; i++) {
            var h = (bins[i] / max) * (c.height - 16);
            var x = 8 + i * w;
            var grad = ctx.createLinearGradient(x, c.height - 8, x, c.height - 8 - h);
            grad.addColorStop(0, '#28a745');
            grad.addColorStop(0.5, '#e6a700');
            grad.addColorStop(1, '#e63946');
            ctx.fillStyle = grad;
            ctx.fillRect(x + 2, c.height - 8 - h, w - 4, h);
            ctx.fillStyle = '#888';
            ctx.font = '9px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText((i * 1000) + 'Hz', x + w/2, c.height - 1);
        }
    };
</script>

<style>
    .debug-shell { max-width: 600px; margin: 0 auto; padding: 1rem; }
    h1 { font-size: 1.4rem; margin-bottom: 1rem; color: var(--accent-color, #e63946); }
    .debug-section { margin-bottom: 1.5rem; }
    h2 { font-size: 1rem; margin-bottom: 0.5rem; color: var(--text-color, #f0f0f0); }
    .section-note { font-size: 0.8rem; color: var(--text-muted, #888); margin-bottom: 0.75rem; }
    .status-grid { display: flex; flex-direction: column; gap: 0.3rem; }
    .stat-row { display: flex; justify-content: space-between; font-size: 0.85rem; padding: 0.3rem 0; border-bottom: 1px solid var(--border-color, #333); }
    .stat-value { font-weight: 600; }
    .stat-value.ok { color: #28a745; }
    .stat-value.err { color: #dc3545; }
    .servo-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; padding: 0.4rem; background: #1a1a1a; border-radius: 6px; }
    .servo-head { display: flex; flex-direction: column; align-items: center; min-width: 45px; gap: 2px; }
    .servo-label { font-size: 0.85rem; font-weight: 700; }
    .servo-state { font-size: 0.55rem; font-weight: 600; padding: 1px 4px; border-radius: 3px; text-transform: uppercase; }
    .servo-state.held { background: #1a3a1a; color: #28a745; }
    .servo-state.dropped { background: #3a1a1a; color: #dc3545; }
    .servo-slider { flex: 1; min-width: 0; }
    .servo-dir-group { flex-shrink: 0; }
    .servo-dir { width: 36px; height: 32px; border: 1px solid #555; border-radius: 6px; background: #222; color: #888; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 0.55rem; transition: all 0.2s; line-height: 1; gap: 1px; }
    .servo-dir.active { border-color: #28a745; color: #28a745; background: #1a3a1a; }
    .servo-dir:hover { border-color: var(--accent-color, #e63946); }
    .dir-icon { font-size: 0.7rem; }
    .dir-label { font-size: 0.5rem; text-transform: uppercase; }
    .servo-toggle { width: 32px; height: 32px; flex-shrink: 0; border: 1px solid var(--accent-color, #e63946); border-radius: 6px; background: transparent; color: var(--accent-color, #e63946); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; }
    .servo-toggle:hover { background: var(--accent-color, #e63946); color: #fff; }
    .toggle-icon { line-height: 1; }
    .sound-controls { background: #1a1a1a; border-radius: 6px; padding: 0.75rem; }
    .toggle-row { display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
    .switch { position: relative; width: 44px; height: 24px; display: inline-block; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; inset: 0; background: #444; border-radius: 24px; transition: 0.3s; }
    .slider::before { content: ''; position: absolute; left: 3px; bottom: 3px; width: 18px; height: 18px; background: #fff; border-radius: 50%; transition: 0.3s; }
    .switch input:checked + .slider { background: #28a745; }
    .switch input:checked + .slider::before { transform: translateX(20px); }
    .spectrum-container { background: #111; border-radius: 6px; padding: 0; overflow: hidden; }
    #fftCanvas { display: block; width: 100%; height: auto; max-width: 520px; }
    .debug-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; }
    .back-link { color: var(--text-muted, #888); font-size: 0.8rem; text-decoration: none; }
    .gh-link { color: var(--text-muted, #888); font-size: 0.8rem; text-decoration: none; }
    .gh-link:hover { color: var(--accent-color, #e63946); }
</style>

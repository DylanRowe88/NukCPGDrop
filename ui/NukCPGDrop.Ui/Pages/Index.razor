@page "/"
@implements IDisposable
@using NukCPGDrop.Ui.Models

<PageTitle>NukCPGDrop</PageTitle>

<div class="app-shell">
    <LogoDisplay />

    <div class="main-controls">
        <DifficultySelector
            Interval="@_interval"
            RandomEnabled="@_randomEnabled"
            RangeMin="@_rangeMin"
            RangeMax="@_rangeMax"
            DoubleDrop="@_doubleDrop"
            IntervalChanged="OnIntervalChangedAsync"
            OnRandomToggled="OnRandomToggledAsync"
            OnRangeChanged="OnRangeChangedAsync"
            OnDoubleDropChanged="OnDoubleDropChangedAsync" />

        @if (allHeld)
        {
            <DropButton Label="DROP ALL"
                        Subtitle="Start random sequence"
                        Disabled="@_isRunning"
                        OnClick="StartDrop" />
        }
        else
        {
            <DropButton Label="RESET"
                        Subtitle="Hold all cans again"
                        Disabled="@_isRunning"
                        OnClick="ResetAll" />
        }

        @if (_isRunning)
        {
            <div class="sequence-progress">
                <div class="progress-bar">
                    <div class="progress-fill"
                         style="width: @($"{ProgressPercent}%")"></div>
                </div>
                <span class="progress-label">@(_dropCount / (_doubleDrop ? 2 : 1))/@(_doubleDrop ? 3 : 6)</span>
            </div>
        }

        <DropStatus Held="@(_status?.Held ?? new bool[6])"
                    DroppingIndex="@_droppingIndex"
                    SequenceActive="@_isRunning" />
    </div>

    <div class="status-bar">
        <span class="status-label">
            <span class="hardware-dot @(_pca9685Ok ? "online" : "offline")"></span>
            PCA9685
        </span>
        <span>Drops: @TotalDrops</span>
        <span class="status-label">
            ESP
            <span class="connection-dot @(_connected ? "online" : "offline")"></span>
        </span>
    </div>
</div>

@code {
    [Inject] private ApiService Api { get; set; } = default!;
    [Inject] private StateService State { get; set; } = default!;

    private SystemStatus? _status;
    private bool _isRunning;
    private bool _connected;
    private bool _pca9685Ok;
    private bool _allHeld = true;
    private int _droppingIndex = -1;
    private int _dropCount;
    private bool _doubleDrop;
    private int _interval = 2000;
    private bool _randomEnabled;
    private int _rangeMin = 300;
    private int _rangeMax = 2000;
    private Timer? _pollTimer;

    private int TotalDrops => _status?.DropCount ?? 0;
    private bool allHeld => _status?.Held.All(h => h) ?? true;
    private double ProgressPercent => _doubleDrop
        ? Math.Min(100, _dropCount / 3.0 * 100)
        : Math.Min(100, _dropCount / 6.0 * 100);

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatus();
        _pollTimer = new Timer(async _ => await RefreshStatus(), null, 500, 800);
    }

    private async Task RefreshStatus()
    {
        var prev = _status;
        _status = await Api.GetStatusAsync();
        _connected = _status != null;

        if (_status != null)
        {
            _pca9685Ok = _status.Pca9685Present;
            _allHeld = _status.Held.All(h => h);

            if (prev != null && !_isRunning)
            {
                int droppedNow = 0;
                for (int i = 0; i < 6; i++)
                    if (prev.Held[i] && !_status.Held[i]) droppedNow++;

                if (droppedNow > 0)
                {
                    _isRunning = true;
                    _dropCount += droppedNow;
                    _doubleDrop = _status.DoubleDrop;

                    for (int i = 0; i < 6; i++)
                        if (prev.Held[i] && !_status.Held[i])
                            _ = AnimateDrop(i);

                    if (_dropCount >= (_status.DoubleDrop ? 3 : 6))
                    {
                        await Task.Delay(600);
                        _isRunning = false;
                        _dropCount = 0;
                        _droppingIndex = -1;
                    }
                }
            }
        }

        State.NotifyStateChanged();
        StateHasChanged();
    }

    private async Task AnimateDrop(int idx)
    {
        _droppingIndex = idx;
        StateHasChanged();
        await Task.Delay(500);
        if (_droppingIndex == idx) _droppingIndex = -1;
    }

    private async Task ResetAll()
    {
        await Api.ResetAllAsync();
        _dropCount = 0;
        _droppingIndex = -1;
        _isRunning = false;
        await RefreshStatus();
    }

    private async Task StartDrop()
    {
        _isRunning = true;
        _dropCount = 0;
        _doubleDrop = _status?.DoubleDrop ?? false;
        var config = new DropConfiguration
        {
            Difficulty = _randomEnabled ? Difficulty.Random : Difficulty.Short,
            DoubleDrop = _doubleDrop,
        };
        config.CustomInterval = _randomEnabled ? 0 : _interval;
        config.RangeMin = _rangeMin;
        config.RangeMax = _rangeMax;
        await Api.UpdateConfigAsync(config);
        await Api.DropAllAsync();
    }

    private async Task OnIntervalChangedAsync(int val)
    {
        _interval = val;
        var config = new DropConfiguration
        {
            Difficulty = Difficulty.Short,
            DoubleDrop = _doubleDrop,
            CustomInterval = val,
        };
        await Api.UpdateConfigAsync(config);
    }

    private async Task OnRandomToggledAsync(bool val)
    {
        _randomEnabled = val;
        var config = new DropConfiguration
        {
            Difficulty = val ? Difficulty.Random : Difficulty.Short,
            DoubleDrop = _doubleDrop,
            RangeMin = _rangeMin,
            RangeMax = _rangeMax,
        };
        await Api.UpdateConfigAsync(config);
    }

    private async Task OnRangeChangedAsync((int Min, int Max) range)
    {
        _rangeMin = range.Min;
        _rangeMax = range.Max;
        if (_randomEnabled)
        {
            var config = new DropConfiguration
            {
                Difficulty = Difficulty.Random,
                DoubleDrop = _doubleDrop,
                RangeMin = _rangeMin,
                RangeMax = _rangeMax,
            };
            await Api.UpdateConfigAsync(config);
        }
    }

    private async Task OnDoubleDropChangedAsync(bool val)
    {
        _doubleDrop = val;
        var config = new DropConfiguration
        {
            Difficulty = _randomEnabled ? Difficulty.Random : Difficulty.Short,
            DoubleDrop = val,
            CustomInterval = _interval,
        };
        await Api.UpdateConfigAsync(config);
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}

<style>
    .app-shell {
        max-width: 480px;
        margin: 0 auto;
        padding: clamp(0.5rem, 3vw, 2rem);
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
    }
    .main-controls {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.75rem;
    }
    .sequence-progress {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .progress-bar {
        flex: 1;
        height: 8px;
        background: var(--border-color, #333);
        border-radius: 4px;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--accent-color, #e63946), #c1121f);
        border-radius: 4px;
        transition: width 0.3s ease;
    }
    .progress-label {
        font-size: clamp(0.75rem, 2vw, 0.9rem);
        color: var(--text-muted, #888);
        min-width: 2rem;
        text-align: right;
    }
    .status-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        font-size: clamp(0.65rem, 1.8vw, 0.8rem);
        color: var(--text-muted, #888);
    }
    .status-label {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    .connection-dot, .hardware-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #333;
        transition: background 0.3s;
        display: inline-block;
    }
    .connection-dot.online { background: #28a745; }
    .hardware-dot.online { background: #e63946; }
</style>

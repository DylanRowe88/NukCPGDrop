@page "/"
@attribute [RenderModeWebAssembly]

<PageTitle>NukCPGDrop</PageTitle>

<div class="app-shell">
    <LogoDisplay />

    <div class="main-controls">
        <DifficultySelector
            Selected="@State.Config.Difficulty"
            DoubleDrop="@State.Config.DoubleDrop"
            OnDifficultyChanged="OnDifficultyChanged"
            OnDoubleDropChanged="OnDoubleDropChanged" />

        <DropButton Label="DROP ALL"
                    Subtitle="Start random sequence"
                    Disabled="@_isRunning"
                    OnClick="StartDrop" />

        <DropStatus Held="@(_status?.Held ?? new bool[6])" />
    </div>

    <div class="status-bar">
        <span>Drops: @(_status?.DropCount ?? 0)</span>
        <span class="connection-dot @(_connected ? "online" : "offline")"></span>
    </div>
</div>

@code {
    [Inject] private ApiService Api { get; set; } = default!;
    [Inject] private StateService State { get; set; } = default!;

    private SystemStatus? _status;
    private bool _isRunning;
    private bool _connected;
    private Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatus();
        _pollTimer = new Timer(async _ => await RefreshStatus(), null, 0, 2000);
    }

    private async Task RefreshStatus()
    {
        _status = await Api.GetStatusAsync();
        _connected = _status != null;
        State.NotifyStateChanged();
        StateHasChanged();
    }

    private async Task StartDrop()
    {
        _isRunning = true;
        await Api.DropAllAsync();
        await Task.Delay(15000);
        _isRunning = false;
    }

    private async Task OnDifficultyChanged(Difficulty d)
    {
        State.Config.Difficulty = d;
        await Api.UpdateConfigAsync(State.Config);
    }

    private async Task OnDoubleDropChanged(ChangeEventArgs e)
    {
        State.Config.DoubleDrop = (bool)(e.Value ?? false);
        await Api.UpdateConfigAsync(State.Config);
    }

    public void Dispose() => _pollTimer?.Dispose();
}

<style>
    .app-shell {
        max-width: 480px;
        margin: 0 auto;
        padding: clamp(0.5rem, 3vw, 2rem);
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
    }
    .main-controls {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1rem;
    }
    .status-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        font-size: clamp(0.75rem, 2vw, 0.9rem);
        color: var(--text-muted, #666);
    }
    .connection-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #dc3545;
        transition: background 0.3s;
    }
    .connection-dot.online { background: #28a745; }
</style>

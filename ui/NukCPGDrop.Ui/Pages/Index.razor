@page "/"
@implements IDisposable
@using NukCPGDrop.Ui.Models

<PageTitle>NukCPGDrop</PageTitle>

<div class="app-shell">
    <div class="logo-bar">
        <LogoDisplay />
    </div>

    <div class="main-controls">
        <DifficultySelector
            Interval="@_interval"
            RandomEnabled="@_randomEnabled"
            RangeMin="@_rangeMin"
            RangeMax="@_rangeMax"
            DoubleDrop="@_doubleDrop"
            IntervalChanged="OnIntervalChangedAsync"
            OnRandomToggled="OnRandomToggledAsync"
            RangeChanged="OnRangeChangedAsync"
            OnDoubleDropChanged="OnDoubleDropChangedAsync" />

        @if (_allHeld)
        {
            <DropButton Label="DROP ALL"
                        Subtitle="Start random sequence"
                        Disabled="@_isRunning"
                        OnClick="StartDrop" />
        }
        else
        {
            <DropButton Label="RESET"
                        Subtitle="Hold all cans again"
                        Disabled="@_isRunning"
                        OnClick="ResetAll" />
        }

        @if (_isRunning)
        {
            <div class="sequence-progress">
                <div class="progress-bar">
                    <div class="progress-fill"
                         style="width: @($"{ProgressPercent}%")"></div>
                </div>
                <span class="progress-label">@(_dropCount / (_doubleDrop ? 2 : 1))/@(_doubleDrop ? 3 : 6)</span>
            </div>
        }

        <DropStatus Held="@(_status?.Held ?? new bool[6])"
                    DroppingIndex="@_droppingIndex"
                    SequenceActive="@_isRunning"
                    OnToggleCan="@HandleToggleCan" />
    </div>

    <div class="status-bar">
        <span>Drops: @TotalDrops</span>
        <span class="rssi-indicator" title="RSSI: @(_status?.Wifi?.Rssi ?? 0) dBm">
            <WifiIcon Signal="@WifiSignalLevel" Size="16px" Color="var(--accent-color, #e63946)" InactiveOpacity="0.15" />
        </span>
        <div class="status-right">
            @if (_status?.Led != null)
            {
                <span class="led-twin" title="RGB LED"
                      style="background: rgb(@_status.Led.R, @_status.Led.G, @_status.Led.B);"></span>
            }
            <a href="/debug" class="debug-link">Debug</a>
        </div>
    </div>
</div>

@code {
    [Inject] private ApiService Api { get; set; } = default!;
    [Inject] private StateService State { get; set; } = default!;

    private SystemStatus? _status;
    private bool _isRunning;
    private bool _connected;
    private bool _pca9685Ok;
    private bool _allHeld = true;
    private int _droppingIndex = -1;
    private int _dropCount;
    private bool _doubleDrop;
    private int _interval = 2000;
    private bool _randomEnabled;
    private int _rangeMin = 300;
    private int _rangeMax = 2000;
    private Timer? _pollTimer;

    private int TotalDrops => _status?.DropCount ?? 0;
    private bool allHeld => _status?.Held.All(h => h) ?? true;
    private double ProgressPercent => _doubleDrop
        ? Math.Min(100, _dropCount / 3.0 * 100)
        : Math.Min(100, _dropCount / 6.0 * 100);

    private int WifiSignalLevel
    {
        get
        {
            int r = _status?.Wifi?.Rssi ?? -100;
            if (r > -50) return 4;
            if (r > -65) return 3;
            if (r > -75) return 2;
            if (r > -85) return 1;
            return 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatus();
        _pollTimer = new Timer(async _ => await InvokeAsync(RefreshStatus), null, 500, 2000);
    }

    private async Task RefreshStatus()
    {
        SystemStatus? prev = _status;
        _status = await Api.GetStatusAsync();
        _connected = _status != null;

        if (_status != null)
        {
            _pca9685Ok = _status.Pca9685Present;
            _allHeld = _status.Held.All(h => h);

            if (prev != null)
            {
                int droppedNow = 0;
                for (int i = 0; i < 6; i++)
                    if (prev.Held[i] && !_status.Held[i]) droppedNow++;

                if (droppedNow > 0)
                {
                    _isRunning = true;
                    _dropCount += droppedNow;
                    _doubleDrop = _status.DoubleDrop;
                    for (int i = 0; i < 6; i++)
                        if (prev.Held[i] && !_status.Held[i])
                            _ = AnimateDrop(i);
                }

                int heldCount = _status.Held.Count(h => h);
                int threshold = _status.DoubleDrop ? 3 : 6;
                if (heldCount == 0 || _dropCount >= threshold)
                {
                    _isRunning = false;
                    _dropCount = 0;
                    _droppingIndex = -1;
                }
            }
        }
        State.NotifyStateChanged();
        StateHasChanged();
    }

    private async Task AnimateDrop(int idx) { _droppingIndex = idx; StateHasChanged(); await Task.Delay(500); if (_droppingIndex == idx) _droppingIndex = -1; }

    private async Task HandleToggleCan(int idx)
    {
        if (_status == null || idx >= _status.Held.Length) return;
        bool wasHeld = _status.Held[idx];
        if (wasHeld) await Api.DropOneAsync(idx + 1); else await Api.HoldOneAsync(idx + 1);
        await Task.Delay(100);
        await RefreshStatus();
    }

    private async Task ResetAll()
    {
        await Api.ResetAllAsync();
        _dropCount = 0; _droppingIndex = -1; _isRunning = false;
        await RefreshStatus();
    }

    private async Task StartDrop()
    {
        _isRunning = true; _dropCount = 0; _doubleDrop = _status?.DoubleDrop ?? false;
        var c = new DropConfiguration { Difficulty = _randomEnabled ? Difficulty.Random : Difficulty.Short, DoubleDrop = _doubleDrop, CustomInterval = _randomEnabled ? 0 : _interval, RangeMin = _rangeMin, RangeMax = _rangeMax };
        await Api.UpdateConfigAsync(c);
        await Api.DropAllAsync();
    }

    private async Task OnIntervalChangedAsync(int v) { _interval = v; await Api.UpdateConfigAsync(new DropConfiguration { Difficulty = Difficulty.Short, DoubleDrop = _doubleDrop, CustomInterval = v }); }
    private async Task OnRandomToggledAsync(bool v) { _randomEnabled = v; await Api.UpdateConfigAsync(new DropConfiguration { Difficulty = v ? Difficulty.Random : Difficulty.Short, DoubleDrop = _doubleDrop, RangeMin = _rangeMin, RangeMax = _rangeMax }); }
    private async Task OnRangeChangedAsync((int Min, int Max) r) { _rangeMin = r.Min; _rangeMax = r.Max; if (_randomEnabled) await Api.UpdateConfigAsync(new DropConfiguration { Difficulty = Difficulty.Random, DoubleDrop = _doubleDrop, RangeMin = _rangeMin, RangeMax = _rangeMax }); }
    private async Task OnDoubleDropChangedAsync(bool v) { _doubleDrop = v; await Api.UpdateConfigAsync(new DropConfiguration { Difficulty = _randomEnabled ? Difficulty.Random : Difficulty.Short, DoubleDrop = v, CustomInterval = _interval }); }
    public void Dispose() => _pollTimer?.Dispose();
}

<style>
    .app-shell { max-width: 480px; margin: 0 auto; padding: clamp(0.5rem, 3vw, 2rem); min-height: 100dvh; display: flex; flex-direction: column; }
    .logo-bar { background: linear-gradient(180deg, #1a1a1a 0%, var(--bg-color, #0d0d0d) 100%); border-bottom: 1px solid var(--border-color, #333); margin: -0.5rem -2rem 0; padding: 0.5rem 2rem 0; width: calc(100% + 4rem); }
    .main-controls { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 0.75rem; }
    .sequence-progress { display: flex; align-items: center; gap: 0.75rem; }
    .progress-bar { flex: 1; height: 8px; background: var(--border-color, #333); border-radius: 4px; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent-color, #e63946), #c1121f); border-radius: 4px; transition: width 0.3s ease; }
    .progress-label { font-size: clamp(0.75rem, 2vw, 0.9rem); color: var(--text-muted, #888); min-width: 2rem; text-align: right; }
    .status-bar { display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; font-size: clamp(0.65rem, 1.8vw, 0.8rem); color: var(--text-muted, #888); }
    .status-right { display: flex; align-items: center; gap: 0.5rem; }
    .rssi-indicator { font-size: clamp(0.7rem, 1.5vw, 0.85rem); letter-spacing: 1px; cursor: default; }
    .led-twin { width: 10px; height: 10px; border-radius: 50%; display: inline-block; border: 1px solid #555; transition: background 0.3s; }
    .debug-link { color: var(--text-muted, #555); text-decoration: none; font-size: clamp(0.55rem, 1.5vw, 0.7rem); text-transform: uppercase; letter-spacing: 0.1em; }
    .debug-link:hover { color: var(--accent-color, #e63946); }
</style>

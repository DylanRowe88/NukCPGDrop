@page "/"
@implements IDisposable
@using NukCPGDrop.Ui.Models
@inject NavigationManager Nav

<PageTitle>NukCPGDrop</PageTitle>

<div class="app-shell">
    <div class="logo-bar"><LogoDisplay /></div>

    <div class="main-controls">

        @* Drop / Reset button *@
        @if (_allHeld) {
            <DropButton Label="DROP ALL" Subtitle="Start random sequence" Disabled="@_isRunning" OnClick="StartDrop" />
        } else {
            <DropButton Label="RESET" Subtitle="Hold all cans again" Disabled="@_isRunning" OnClick="ResetAll" />
        }

        @* Progress *@
        @if (_isRunning) {
            <div class="sequence-progress">
                <div class="progress-bar"><div class="progress-fill" style="width:@(ProgressPercent)%"></div></div>
                <span class="progress-label">@_dropCount/@_activeServos</span>
            </div>
        }

        @* Can grid *@
        <div class="drop-status-grid">
            @for (int i = 0; i < _activeServos; i++) {
                var idx = i;
                <div class="can-slot @(_status?.Held != null && idx < _status.Held.Length && _status.Held[idx] ? "held" : "dropped")" @onclick="() => HandleToggleCan(idx)">
                    <span class="can-number">@(idx + 1)</span>
                    <span class="can-state">@(_status?.Held != null && idx < _status.Held.Length && _status.Held[idx] ? "\u25CF" : "\u25CB")</span>
                </div>
            }
        </div>

        @* Interval Range *@
        <div class="section-row">
            <div class="range-row">
                <span class="range-label">Min</span>
                <span class="range-value">@_rangeMin ms</span>
                <input type="range" class="range-slider" min="100" max="5000" value="@_rangeMin" @onchange="OnRangeMinChanged" />
            </div>
            <div class="range-row">
                <span class="range-label">Max</span>
                <span class="range-value">@_rangeMax ms</span>
                <input type="range" class="range-slider" min="100" max="5000" value="@_rangeMax" @onchange="OnRangeMaxChanged" />
            </div>
        </div>

        @* Held / Dropped positions *@
        <div class="section-row">
            <div class="range-row">
                <span class="range-label">Held</span>
                <span class="range-value">@_svHeld&deg;</span>
                <input type="range" class="range-slider" min="0" max="180" value="@_svHeld" @onchange="OnSvHeldChanged" />
            </div>
            <div class="range-row">
                <span class="range-label">Dropped</span>
                <span class="range-value">@_svDropped&deg;</span>
                <input type="range" class="range-slider" min="0" max="180" value="@_svDropped" @onchange="OnSvDroppedChanged" />
            </div>
        </div>

        @* Sound *@
        <div class="toggle-row">
            <span>Sound</span>
            <label class="switch">
                <input type="checkbox" checked="@(_soundEnabled)" @onchange="OnSoundToggled" />
                <span class="slider"></span>
            </label>
        </div>

        @* FFT Spectrum *@
        <div class="spectrum-box"><canvas id="fftCanvas" width="440" height="60"></canvas></div>

        @* Status line *@
        <div class="status-line">
            <span>Drops: @TotalDrops</span>
            <span>Clients: @(_status?.Wifi?.Clients ?? 0)</span>
            <span><WifiIcon Signal="@WifiSignalLevel" Size="14px" Color="var(--accent-color)" InactiveOpacity="0.15" /></span>
        </div>

    </div>

    @* Servo Count at bottom *@
    <div class="bottom-bar">
        <div class="nuks-row">
            <span class="nuks-label">Nuks</span>
            <button class="cnt-btn" @onclick="DecrementServos">-</button>
            <span class="cnt-value">@_activeServos</span>
            <button class="cnt-btn" @onclick="IncrementServos">+</button>
        </div>
        <small class="version-label">@(_status?.Wifi?.Version ?? "")</small>
    </div>
</div>

@code {
    [Inject] private ApiService Api { get; set; } = default!;
    [Inject] private StateService State { get; set; } = default!;

    private SystemStatus? _status;
    private bool _isRunning, _allHeld = true;
    private int _dropCount, _rangeMin = 300, _rangeMax = 2000, _svHeld, _svDropped = 180, _activeServos = 16;
    private bool _soundEnabled = true;
    private Timer? _pollTimer, _fftTimer;
    private HttpClient _http = new HttpClient();

    private int TotalDrops => _status?.DropCount ?? 0;
    private double ProgressPercent => _activeServos > 0 ? Math.Min(100, _dropCount / (double)_activeServos * 100) : 0;
    private int WifiSignalLevel { get { int r = _status?.Wifi?.Rssi ?? -100; if (r > -50) return 4; if (r > -65) return 3; if (r > -75) return 2; if (r > -85) return 1; return 0; } }

    protected override async Task OnInitializedAsync() {
        await RefreshStatus();
        _pollTimer = new Timer(async _ => await InvokeAsync(RefreshStatus), null, 500, 2000);
        _fftTimer = new Timer(async _ => await InvokeAsync(PollFft), null, 2000, 1000);
    }

    private async Task RefreshStatus() {
        SystemStatus? prev = _status;
        _status = await Api.GetStatusAsync();
        if (_status != null) {
            _allHeld = _status.Held.All(h => h);
            _rangeMin = _status.RangeMin; _rangeMax = _status.RangeMax;
            _svHeld = _status.SvStartPos; _svDropped = _status.SvStopPos;
            _activeServos = _status.ActiveServos > 0 ? _status.ActiveServos : 16;
            _soundEnabled = _status.SoundEnabled;
            if (prev != null) {
                int dropped = 0;
                for (int i = 0; i < _status.Held.Length; i++)
                    if (i < prev.Held.Length && prev.Held[i] && !_status.Held[i]) dropped++;
                if (dropped > 0) { _isRunning = true; _dropCount += dropped; }
                if (_status.Held.Count(h => h) == 0 || _dropCount >= _activeServos) { _isRunning = false; _dropCount = 0; }
            }
        }
        State.NotifyStateChanged(); StateHasChanged();
    }

    private async Task HandleToggleCan(int idx) {
        if (_status == null || idx >= _status.Held.Length) return;
        if (_status.Held[idx]) await Api.DropOneAsync(idx + 1); else await Api.HoldOneAsync(idx + 1);
        await Task.Delay(100); await RefreshStatus();
    }
    private async Task ResetAll() { await Api.ResetAllAsync(); _dropCount = 0; _isRunning = false; await RefreshStatus(); }
    private async Task StartDrop() {
        _isRunning = true; _dropCount = 0;
        await Api.UpdateConfigAsync(FullConfig());
        await Api.DropAllAsync();
    }

    private async Task OnRangeMinChanged(ChangeEventArgs e) { _rangeMin = int.TryParse(e.Value?.ToString(), out var v) ? v : 300; await Api.UpdateConfigAsync(FullConfig()); }
    private async Task OnRangeMaxChanged(ChangeEventArgs e) { _rangeMax = int.TryParse(e.Value?.ToString(), out var v) ? v : 2000; await Api.UpdateConfigAsync(FullConfig()); }
    private DropConfiguration FullConfig() => new() { Difficulty = Difficulty.Random, RangeMin = _rangeMin, RangeMax = _rangeMax, SoundEnabled = _soundEnabled, SvStartPos = _svHeld, SvStopPos = _svDropped, ActiveServos = _activeServos };
    private async Task OnSvHeldChanged(ChangeEventArgs e) { _svHeld = int.TryParse(e.Value?.ToString(), out var v) ? v : 0; await Api.PostAsync("/api/servo_config", new { sv_start_pos = _svHeld, sv_stop_pos = _svDropped }); }
    private async Task OnSvDroppedChanged(ChangeEventArgs e) { _svDropped = int.TryParse(e.Value?.ToString(), out var v) ? v : 180; await Api.PostAsync("/api/servo_config", new { sv_start_pos = _svHeld, sv_stop_pos = _svDropped }); }
    private async Task OnSoundToggled(ChangeEventArgs e) { _soundEnabled = (bool)(e.Value ?? false); await Api.UpdateConfigAsync(FullConfig()); }
    private async Task DecrementServos() { if (_activeServos > 1) { _activeServos--; await Api.UpdateConfigAsync(FullConfig()); } }
    private async Task IncrementServos() { if (_activeServos < 16) { _activeServos++; await Api.UpdateConfigAsync(FullConfig()); } }

    private async Task PollFft() {
        try {
            var json = await _http.GetStringAsync(Nav.BaseUri + "api/audio/fft");
            var fft = System.Text.Json.JsonSerializer.Deserialize<FftData>(json);
            if (fft?.Spectrum != null) await DrawSpectrum(fft.Spectrum);
        } catch { }
    }

    private async ValueTask<IJSObjectReference?> GetCanvas() {
        try { return await JSRuntime.InvokeAsync<IJSObjectReference>("eval", "document.getElementById('fftCanvas')"); } catch { return null; }
    }

    private async Task DrawSpectrum(int[] bins) {
        try {
            var c = await JSRuntime.InvokeAsync<IJSObjectReference>("eval", "document.getElementById('fftCanvas')");
            if (c == null) return;
            var ctx = await c.InvokeAsync<IJSObjectReference>("getContext", "2d");
            int w = 440, h = 60;
            await ctx.InvokeVoidAsync("clearRect", 0, 0, w, h);
            int max = Math.Max(1, bins.Max());
            int barW = (w - 8) / bins.Length;
            for (int i = 0; i < bins.Length; i++) {
                int barH = (int)((double)bins[i] / max * (h - 4));
                int x = 4 + i * barW;
                await ctx.InvokeVoidAsync("fillStyle", i < 3 ? "#28a745" : i < 6 ? "#e6a700" : "#e63946");
                await ctx.InvokeVoidAsync("fillRect", x + 1, h - 2 - barH, barW - 2, barH);
            }
        } catch { }
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    public void Dispose() { _pollTimer?.Dispose(); _fftTimer?.Dispose(); }

    private class FftData { public int[]? Spectrum { get; set; } }
}

<style>
    .app-shell { max-width: 440px; margin: 0 auto; padding: 0.5rem; min-height: 100dvh; display: flex; flex-direction: column; }
    .logo-bar { margin: -0.5rem -0.5rem 0.3rem; padding: 0.3rem 0.5rem 0; width: calc(100% + 1rem); border-bottom: 1px solid var(--border-color, #333); background: linear-gradient(180deg, #1a1a1a 0%, var(--bg-color, #0d0d0d) 100%); }
    .main-controls { flex: 1; display: flex; flex-direction: column; gap: 0.4rem; overflow-y: auto; }
    .sequence-progress { display: flex; align-items: center; gap: 0.5rem; }
    .progress-bar { flex: 1; height: 6px; background: var(--border-color, #333); border-radius: 3px; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent-color, #e63946), #c1121f); border-radius: 3px; transition: width 0.3s; }
    .progress-label { font-size: 0.75rem; color: var(--text-muted, #888); min-width: 2rem; text-align: right; }
    .drop-status-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.3rem; }
    .can-slot { display: flex; flex-direction: column; align-items: center; padding: 0.4rem 0.2rem; border-radius: 6px; background: #1a1a1a; cursor: pointer; transition: background 0.3s, transform 0.3s; user-select: none; }
    .can-slot:hover { filter: brightness(1.3); }
    .can-slot.held { background: #1a3a1a; box-shadow: 0 0 4px rgba(40,167,69,0.3); }
    .can-slot.dropped { background: #3a1a1a; transform: translateY(4px); opacity: 0.7; }
    .can-number { font-size: 0.75rem; font-weight: 600; }
    .can-state { font-size: 1rem; line-height: 1; }
    .section-row { background: #1a1a1a; border-radius: 6px; padding: 0.4rem 0.6rem; display: flex; flex-direction: column; gap: 0.2rem; }
    .range-row { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; }
    .range-label { min-width: 50px; color: #888; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.65rem; }
    .range-value { min-width: 50px; text-align: right; color: var(--accent-color, #e63946); font-weight: 600; font-size: 0.7rem; }
    .range-slider { flex: 1; accent-color: var(--accent-color, #e63946); height: 3px; }
    .toggle-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; }
    .switch { position: relative; width: 40px; height: 22px; display: inline-block; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; inset: 0; background: #444; border-radius: 22px; transition: 0.3s; }
    .slider::before { content: ''; position: absolute; left: 3px; bottom: 3px; width: 16px; height: 16px; background: #fff; border-radius: 50%; transition: 0.3s; }
    .switch input:checked + .slider { background: #28a745; }
    .switch input:checked + .slider::before { transform: translateX(18px); }
    .spectrum-box { background: #111; border-radius: 4px; overflow: hidden; margin: 0; }
    #fftCanvas { display: block; width: 100%; height: auto; max-width: 440px; }
    .status-line { display: flex; justify-content: space-between; align-items: center; font-size: 0.6rem; color: #888; padding: 0.2rem 0; }
    .bottom-bar { margin-top: auto; border-top: 1px solid #333; padding-top: 0.4rem; display: flex; justify-content: space-between; align-items: center; }
    .nuks-row { display: flex; align-items: center; gap: 0.4rem; }
    .nuks-label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-color, #e63946); min-width: 40px; }
    .cnt-btn { width: 30px; height: 28px; border: 1px solid var(--accent-color, #e63946); border-radius: 4px; background: transparent; color: var(--accent-color, #e63946); font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .cnt-btn:hover { background: var(--accent-color, #e63946); color: #fff; }
    .cnt-value { font-size: 1rem; font-weight: 700; min-width: 20px; text-align: center; }
    .version-label { font-size: 0.55rem; color: #555; }
</style>

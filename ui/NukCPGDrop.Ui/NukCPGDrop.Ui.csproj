<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <BlazorWebAssemblyCompressAll>true</BlazorWebAssemblyCompressAll>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.*" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="EmbedWebAssets" AfterTargets="Publish" Condition="Exists('$(MSBuildProjectDirectory)/../../scripts/embed-web.py')">
    <Exec Command="python ../../scripts/embed-web.py &quot;$(PublishDir)&quot; ../../firmware/main/include/web_assets.h"
          WorkingDirectory="$(MSBuildProjectDirectory)/../.."
          IgnoreExitCode="true" />
  </Target>

</Project>

<svg width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="@Color"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="@Class">

  <circle cx="12" cy="19" r="1" fill="@Color" opacity="@(Signal >= 1 ? 1.0 : InactiveOpacity)" />

  <path d="M8.5 15.5a5 5 0 0 1 7 0" opacity="@(Signal >= 2 ? 1.0 : InactiveOpacity)" />

  <path d="M5 12a10 10 0 0 1 14 0" opacity="@(Signal >= 3 ? 1.0 : InactiveOpacity)" />

  <path d="M2 8.5a15 15 0 0 1 20 0" opacity="@(Signal >= 4 ? 1.0 : InactiveOpacity)" />
</svg>

@code {
    [Parameter] public int Signal { get; set; } = 4;
    [Parameter] public string Size { get; set; } = "24px";
    [Parameter] public string Color { get; set; } = "currentColor";
    [Parameter] public double InactiveOpacity { get; set; } = 0.2;
    [Parameter] public string Class { get; set; } = "";
}

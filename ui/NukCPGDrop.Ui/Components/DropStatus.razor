<div class="drop-status">
    @for (int i = 0; i < 6; i++)
    {
        <div class="can-slot @StatusClass(i) @(DroppingIndex == i ? "dropping" : "")"
             style="animation-delay: @($"{i * 0.1}s")"
             @onclick="() => OnToggleCan.InvokeAsync(i)"
             title="@(Held.Length > i && Held[i] ? "Click to release" : "Click to hold")">
            <span class="can-number">@(i + 1)</span>
            <span class="can-state">@StateSymbol(i)</span>
            @if (DroppingIndex == i)
            {
                <span class="drop-indicator"></span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool[] Held { get; set; } = new bool[6];
    [Parameter] public int DroppingIndex { get; set; } = -1;
    [Parameter] public bool SequenceActive { get; set; }
    [Parameter] public EventCallback<int> OnToggleCan { get; set; }

    private string StatusClass(int i) =>
        i >= Held.Length ? "" : (Held[i] ? "held" : "dropped");

    private string StateSymbol(int i) =>
        i >= Held.Length ? "?" : (Held[i] ? "\u25CF" : "\u25CB");
}

<style>
    .drop-status {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.5rem;
        margin: 1rem 0;
    }
    .can-slot {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0.75rem 0.5rem;
        border-radius: 10px;
        background: var(--slot-bg, #1a1a1a);
        transition: background 0.3s, transform 0.3s;
        cursor: pointer;
        user-select: none;
    }
    .can-slot:hover {
        filter: brightness(1.3);
    }
    .can-slot.held {
        background: var(--held-bg, #1a3a1a);
        box-shadow: 0 0 6px rgba(40, 167, 69, 0.3);
    }
    .can-slot.dropped {
        background: var(--dropped-bg, #3a1a1a);
        transform: translateY(4px);
        opacity: 0.7;
    }
    .can-slot.dropping {
        animation: can-drop 0.4s ease-in forwards;
    }
    .can-number {
        font-size: clamp(0.8rem, 2.5vw, 1rem);
        font-weight: 600;
    }
    .can-state {
        font-size: clamp(1.2rem, 3vw, 1.5rem);
        line-height: 1;
    }
    .drop-indicator {
        position: absolute;
        bottom: -4px;
        width: 20px;
        height: 3px;
        background: var(--accent-color, #e63946);
        border-radius: 2px;
        animation: pulse-indicator 0.6s ease-in-out infinite;
    }
    @@keyframes can-drop {
        0%   { transform: translateY(0); opacity: 1; }
        50%  { transform: translateY(12px); opacity: 0.6; }
        100% { transform: translateY(4px); opacity: 0.7; }
    }
    @@keyframes pulse-indicator {
        0%, 100% { opacity: 1; width: 20px; }
        50%      { opacity: 0.4; width: 30px; }
    }
</style>

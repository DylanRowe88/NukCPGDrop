@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="rs-wrap">
    <div class="rs-track" @ref="trackEl"
         @onpointerdown="OnTrackDown"
         @onpointermove="OnTrackMove"
         @onpointerup="OnPointerUp"
         @onpointercancel="OnPointerUp"
         @onlostpointercapture="OnPointerUp">
        <div class="rs-fill" style="@FillStyle"></div>
        <button type="button" class="rs-thumb" style="left:@(Percent(LowValue))%"
                @onpointerdown="e => OnThumbDown(e, false)"
                tabindex="0" aria-label="Minimum value"></button>
        @if (RangeMode)
        {
            <button type="button" class="rs-thumb rs-thumb-hi" style="left:@(Percent(HighValue))%"
                    @onpointerdown="e => OnThumbDown(e, true)"
                    tabindex="0" aria-label="Maximum value"></button>
        }
    </div>
    <div class="rs-inputs">
        <input class="rs-input" type="number" min="@Min" max="@(RangeMode ? HighValue : Max)" step="@Step"
               value="@LowValue" @onchange="OnLowInput" />
        @if (RangeMode)
        {
            <span class="rs-sep">to</span>
            <input class="rs-input" type="number" min="@LowValue" max="@Max" step="@Step"
                   value="@HighValue" @onchange="OnHighInput" />
        }
    </div>
</div>

@code {
    [Parameter] public bool RangeMode { get; set; }
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public double LowValue { get; set; }
    [Parameter] public double HighValue { get; set; } = 100;
    [Parameter] public EventCallback<double> LowValueChanged { get; set; }
    [Parameter] public EventCallback<double> HighValueChanged { get; set; }

    private ElementReference trackEl;
    private IJSObjectReference? js;
    private bool dragging, dragHigh;
    private double trackLeft, trackWidth;

    private double Percent(double v) => Max > Min ? ((v - Min) / (Max - Min)) * 100.0 : 0;
    private string FillStyle => RangeMode
        ? $"left:{Percent(LowValue):F2}%;width:{Percent(HighValue) - Percent(LowValue):F2}%"
        : $"left:0%;width:{Percent(LowValue):F2}%";

    protected override async Task OnAfterRenderAsync(bool first) {
        if (first) {
            try {
                js = await JS.InvokeAsync<IJSObjectReference>("import", "./js/rangeSlider.js");
            } catch { }
        }
    }

    private async ValueTask<DomRect> GetTrackRect() {
        if (js != null) {
            try { return await js.InvokeAsync<DomRect>("getTrackGeometry", trackEl); } catch { }
        }
        return new DomRect { Left = 0, Width = 300 };
    }

    private async Task CapturePointer(long id) {
        if (js != null) try { await js.InvokeVoidAsync("capturePointer", trackEl, id); } catch { }
    }

    private async Task ReleasePointer(long id) {
        if (js != null) try { await js.InvokeVoidAsync("releasePointer", trackEl, id); } catch { }
    }

    private double ValFromX(double cx) {
        if (trackWidth <= 0) return LowValue;
        double rel = Math.Clamp(cx - trackLeft, 0, trackWidth);
        double val = Min + (rel / trackWidth) * (Max - Min);
        val = Math.Round(val / Step) * Step;
        return Math.Clamp(val, Min, Max);
    }

    private async Task OnTrackDown(PointerEventArgs e) {
        var r = await GetTrackRect();
        trackLeft = r.Left; trackWidth = r.Width;
        if (trackWidth <= 0) return;
        double val = ValFromX(e.ClientX);
        if (RangeMode) {
            double dL = Math.Abs(val - LowValue), dH = Math.Abs(val - HighValue);
            dragHigh = dH < dL;
        }
        dragging = true;
        await CapturePointer(e.PointerId);
        await ApplyValue(val);
    }

    private async Task OnThumbDown(PointerEventArgs e, bool high) {
        var r = await GetTrackRect();
        trackLeft = r.Left; trackWidth = r.Width;
        dragging = true; dragHigh = high;
        await CapturePointer(e.PointerId);
    }

    private async Task OnTrackMove(PointerEventArgs e) {
        if (!dragging) return;
        await ApplyValue(ValFromX(e.ClientX));
    }

    private Task OnPointerUp(PointerEventArgs e) {
        dragging = false;
        _ = ReleasePointer(e.PointerId);
        return Task.CompletedTask;
    }

    private async Task ApplyValue(double val) {
        if (RangeMode) {
            if (dragHigh) {
                val = Math.Max(val, LowValue);
                if (Math.Abs(val - HighValue) < 0.01) return;
                HighValue = val;
                await HighValueChanged.InvokeAsync(val);
            } else {
                val = Math.Min(val, HighValue);
                if (Math.Abs(val - LowValue) < 0.01) return;
                LowValue = val;
                await LowValueChanged.InvokeAsync(val);
            }
        } else {
            if (Math.Abs(val - LowValue) < 0.01) return;
            LowValue = val;
            await LowValueChanged.InvokeAsync(val);
        }
    }

    private async Task OnLowInput(ChangeEventArgs e) {
        if (double.TryParse(e.Value?.ToString(), out double v))
            await ApplyValue(Math.Clamp(v, Min, RangeMode ? HighValue : Max));
    }

    private async Task OnHighInput(ChangeEventArgs e) {
        if (double.TryParse(e.Value?.ToString(), out double v))
            await ApplyValue(Math.Max(v, LowValue));
    }

    public async ValueTask DisposeAsync() { if (js != null) await js.DisposeAsync(); }

    private class DomRect { public double Left { get; set; } public double Width { get; set; } }
}

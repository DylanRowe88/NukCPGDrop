# NukCPGDrop Environment Configuration
# Copy to .env and adjust per your machine

# ESP-IDF installation path (required for firmware builds)
# Windows: C:/Users/you/source/repos/esp-idf
# Linux/macOS: /home/you/esp/esp-idf
IDF_PATH=C:/Users/thedy/source/repos/esp-idf

# Serial port for E2E hardware testing (optional)
# Leave empty to auto-detect
BOARD_TYPE=

# GitHub CLI (gh) is required for release uploads
# Authenticate with: gh auth login
